---
const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="container">

    <div class="footer-main">

      <div class="footer-brand">

        <a
          href="/"
          class="footer-logo"
          aria-label="PINE Projects – Startseite"
        >
          <span aria-hidden="true">◇</span>

          <div>
            <strong>PINE</strong>
            <small>PROJECTS</small>
          </div>
        </a>

        <p>
          Open Source Projekte rund um Home Automation,
          IoT, Server, 3D-Druck und DIY.
        </p>

        <p class="footer-claim">
          SMART. OPEN. CONNECTED.
        </p>

      </div>


      <nav
        class="footer-navigation"
        aria-label="Navigation im Footer"
      >

        <div>
          <h2>Projekte</h2>

          <ul>
            <li>
              <a href="/projekte">Alle Projekte</a>
            </li>

            <li>
              <a href="/technologien">Technologien</a>
            </li>
          </ul>
        </div>


        <div>
          <h2>PINE</h2>

          <ul>
            <li>
              <a href="/ueber-mich">Über mich</a>
            </li>

            <li>
              <a href="/kontakt">Kontakt</a>
            </li>
          </ul>
        </div>


        <div>
          <h2>Rechtliches</h2>

          <ul>
            <li>
              <a href="/impressum">Impressum</a>
            </li>

            <li>
              <a href="/datenschutz">Datenschutz</a>
            </li>
          </ul>
        </div>

      </nav>

    </div>


    <div class="footer-bottom">

      <p>
        © {year} PINE Projects
      </p>

      <p>
        Built with Astro
      </p>

    </div>

  </div>

</footer>