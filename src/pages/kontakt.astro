---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zu PINE Projects für Fragen, Feedback und Austausch rund um Technik, Open Source und Projekte."
>

  <section class="section contact-page">

    <div class="container">

      <header class="contact-header">

        <p class="section-eyebrow">
          KONTAKT
        </p>

        <h1>
          Interesse oder Feedback?
        </h1>

        <p class="contact-intro">
          Fragen zu einem Projekt, Hinweise zur Dokumentation oder einfach
          Interesse an technischem Austausch? Dann melde dich gerne.
        </p>

      </header>


      <div class="contact-grid">

        <section class="contact-card">

          <span class="contact-number">
            01
          </span>

          <h2>
            E-Mail
          </h2>

          <p>
            Für Fragen, Feedback oder technischen Austausch erreichst du
            mich am einfachsten per E-Mail.
          </p>

          <a
            href="mailto:DEINE-EMAIL-ADRESSE"
            class="button button-primary"
          >
            E-Mail schreiben
            <span aria-hidden="true">→</span>
          </a>

        </section>


        <section class="contact-card">

          <span class="contact-number">
            02
          </span>

          <h2>
            GitHub
          </h2>

          <p>
            Quellcode, Konfigurationen und weitere technische Inhalte
            findest du auf GitHub.
          </p>

          <a
            href="https://github.com/DEIN-GITHUB-NAME"
            target="_blank"
            rel="noopener noreferrer"
            class="button"
          >
            GitHub öffnen
            <span aria-hidden="true">↗</span>
          </a>

        </section>

      </div>


      <section class="contact-note">

        <p class="section-eyebrow">
          HINWEIS
        </p>

        <p>
          PINE Projects ist eine persönliche technische Projekt- und
          Dokumentationsplattform. Es besteht kein Anspruch auf Support
          oder individuelle Projektberatung.
        </p>

      </section>

    </div>

  </section>

</BaseLayout>